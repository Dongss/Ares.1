{
  "name": "ares1",
  "version": "0.1.0",
  "private": true,
  "description": "Ares.1, a self-bootstrapping multi-agent orchestrator: a Master process that schedules agent CLIs through workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ares1": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "dev": "tsx src/cli.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real": "vitest run --config vitest.real.config.ts",
    "lint": "biome check . && tsc --noEmit && tsc --noEmit -p web",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
